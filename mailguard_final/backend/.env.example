# ============================================================
# MailGuard backend configuration
# Copy this file to ".env" and fill in the values.
# Every "required" value MUST be set or the app will refuse to start.
# Everything marked "optional" has a safe free fallback already
# built into the code, so you can leave it blank for your first run.
# ============================================================

# ---- Security (REQUIRED) -----------------------------------
# Random long string used to sign login tokens (JWT).
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_random_64_char_hex_string

# The single analyst login for this MVP.
# Password is stored as a bcrypt HASH, never plain text.
# Generate a hash with:
#   python -c "from passlib.hash import bcrypt; print(bcrypt.hash('YOUR_PASSWORD'))"
ANALYST_USERNAME=analyst
ANALYST_PASSWORD_HASH=replace_with_output_of_the_command_above

# Token lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=120

# ---- Database (REQUIRED, default works out of the box) -----
# SQLite needs no setup at all - perfect for the demo/hackathon.
# For production swap to Postgres, e.g.
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/mailguard
DATABASE_URL=sqlite:///./mailguard.db

# ---- CORS ----------------------------------------------------
# The URL your frontend runs on.
FRONTEND_ORIGIN=http://localhost:5173

# ---- Geolocation / IP enrichment (OPTIONAL) -----------------
# Default: the code calls the free ip-api.com endpoint, no key needed
# (45 requests/minute limit - fine for a demo/hackathon).
# For higher limits / more accuracy, get a free IPinfo.io token:
#   1. Go to https://ipinfo.io/signup
#   2. Create a free account (50,000 requests/month free)
#   3. Copy the token from your dashboard
IPINFO_TOKEN=

# ---- Attachment threat intel (OPTIONAL) ----------------------
# Default: attachments are checked only against the local hash
# blocklist file (backend/app/modules/local_hash_blocklist.txt).
# For real-world threat intel, get a free VirusTotal API key:
#   1. Go to https://www.virustotal.com/gui/join-us
#   2. Create an account, go to your profile -> API key
#   3. Free tier = 4 requests/minute, 500/day - fine for a demo.
VIRUSTOTAL_API_KEY=

# ---- LLM explanation layer (OPTIONAL) -------------------------
# If set, the content module will ask Claude for one extra
# plain-English paragraph explaining WHY an email looks suspicious.
# The core score never depends on this - it is a bonus explanation.
#   1. Go to https://console.anthropic.com/
#   2. Create an account and add billing (pay-as-you-go)
#   3. Go to "API Keys" -> "Create Key" and copy it
ANTHROPIC_API_KEY=

# ---- Fraud score thresholds (OPTIONAL tuning) ----------------
# 0-100 composite score. Anything >= FLAG_THRESHOLD shows up as
# "flagged" on the analyst dashboard by default.
FLAG_THRESHOLD=40
FRAUD_THRESHOLD=70
